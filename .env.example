PORT=3000
NODE_ENV=development
# Gemini API key (server-side only; never expose to the client).
GEMINI_API_KEY=
# Local directory for preserved evidence bytes (optional).
EVIDENCE_DIR=

# ===== Staff authentication =====
# Identity is seeded from the environment at startup; there are no hardcoded
# credentials. For production, prefer a pre-computed scrypt hash:
#   ADMIN_PASSWORD_HASH=scrypt$<salt-hex>$<derived-key-hex>
ADMIN_EMAIL=warden@campus.edu
ADMIN_NAME=Dr. Evelyn Ward
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Optional technician account (used by the authenticated maintenance flow).
TECHNICIAN_EMAIL=
TECHNICIAN_NAME=
TECHNICIAN_DEPARTMENT=
TECHNICIAN_PASSWORD=
TECHNICIAN_PASSWORD_HASH=
